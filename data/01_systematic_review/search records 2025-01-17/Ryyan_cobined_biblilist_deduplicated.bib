title={Developmental stress has sex-specific effects on nestling growth and adult metabolic rates but no effect on adult body size or body composition in song sparrows},
authors={Schmidt, Kim L.; MacDougall-Shackleton, Elizabeth A.; MacDougall-Shackleton, Scott A.},
