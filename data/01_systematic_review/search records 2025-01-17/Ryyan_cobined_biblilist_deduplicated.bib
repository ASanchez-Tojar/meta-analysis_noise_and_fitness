title={Influence of Urbanization on Body Size, Condition, and Physiology in an Urban Exploiter: A Multi-Component Approach},
authors={Meillère, Alizée; Brischoux, François; Parenteau, Charline; Angelier, Frédéric},
journal={PloS one},
