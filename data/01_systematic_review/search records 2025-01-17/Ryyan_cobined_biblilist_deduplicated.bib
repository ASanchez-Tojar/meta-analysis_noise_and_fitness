title={A Systematic Review of Research Investigating the Combined Ecological Impact of Anthropogenic Noise and Artificial Light at Night},
authors={Halfwerk, Wouter; Jerem, Paul},
journal={Frontiers in Ecology and Evolution},
issn={},
volume={9},
issue={NA},
pages={NA-NA},
