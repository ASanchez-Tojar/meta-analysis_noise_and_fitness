@ARTICLE{987,
key={rayyan-138684440},
title={Early-life telomere length predicts lifespan and lifetime reproductive success in a wild bird.},
authors={Eastwood, Justin R.; Hall, Michelle L.; Teunissen, Niki; Kingma, Sjouke A.; Aranzamendi, Nataly H...},
journal={Molecular ecology},
issn={},
volume={28},
