@ARTICLE{2173,
key={rayyan-138685986},
title={Immediate and delayed effects of growth conditions on ageing parameters in nestling zebra finches},
authors={Reichert, Sophie; Criscuolo, François; Zahn, Sandrine; Arrivé, Mathilde; Bize, Pierre; Massemin, ...},
journal={The Journal of experimental biology},
