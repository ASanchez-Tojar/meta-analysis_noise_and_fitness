title={Evidence of a Minimum Patch Size Threshold of Reproductive Success in an Endangered Songbird},
authors={Butcher, Jerrod A.; Morrison, Michael L.; Ransom, Dean; Slack, R. Douglas; Wilkins, R. Neal},
