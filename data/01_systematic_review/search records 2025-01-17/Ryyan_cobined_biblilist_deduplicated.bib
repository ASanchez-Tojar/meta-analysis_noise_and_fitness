@ARTICLE{136,
key={rayyan-138683552},
title={Fetal growth outcomes following peri-implantation exposure of Long-Evans rats to noise and ozone differ by sex},
authors={Miller, Colette N.; Kodavanti, Urmila P.; Stewart, Erica J.; Schladweiler, Mette C.; Richards, Ju...},
journal={Biology of sex differences},
