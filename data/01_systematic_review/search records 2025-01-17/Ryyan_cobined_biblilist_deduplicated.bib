@ARTICLE{146,
key={rayyan-138683563},
title={Factors influencing nest site selection in a rapidly declining shorebird, the Eurasian curlew},
authors={Rivers, Eleanor Marie; Short, Mike J.; Page, Andy; Potts, Peter M.; Hodder, Kathy; Hoodless, Andr...},
journal={Journal of Avian Biology},
