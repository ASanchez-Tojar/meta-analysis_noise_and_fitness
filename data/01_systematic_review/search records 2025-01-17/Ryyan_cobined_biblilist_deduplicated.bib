@ARTICLE{2674,
key={rayyan-138686790},
title={SONYC Urban Sound Tagging (SONYC-UST): a multilabel dataset from an urban acoustic sensor network},
authors={Cartwright, Mark and Cramer, Jason and Mendez, Ana Elisa Mendez and Wang, Yu and Wu, Ho-Hsiang and Lostanlen, Vincent and Fuentes, Magdalena and Dove, Graham and Mydlarz, Charlie and Salamon, Justin and Nov, Oded and Bello, Juan Pablo},
journal={Zenodo},
issn={},
volume={NA},
issue={NA},
pages={},
