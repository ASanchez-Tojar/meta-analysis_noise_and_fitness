@ARTICLE{2731,
key={rayyan-138686959},
title={Separate and combined effects of boat noise and a live crab predator on mussel valve gape behavior},
authors={Hubert, Jeroen and van der Burg, A. Danielle and Witbaard, Rob and Slabbekoorn, Hans},
journal={BEHAVIORAL ECOLOGY},
issn={["1045-2249", "1465-7279"]},
