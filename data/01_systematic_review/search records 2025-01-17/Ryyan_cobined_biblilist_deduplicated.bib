@ARTICLE{840,
key={rayyan-138684286},
title={Spatial variation in sound frequency components across an urban area derived from mobile surveys},
authors={Alvares-Sanches, Tatiana; Osborne, Patrick E.; White, Paul R.; Bahaj, AbuBakr S.},
journal={Future Cities and Environment},
