title={Themed Issue Article: Stress in Vertebrates Effects of anthropogenic noise on endocrine and reproductive function in White's treefrog, Litoria caerulea},
authors={Kaiser, Kristine; Devito, Julia; Jones, Caitlin G.; Marentes, Adam; Perez, Rachel; Umeh, Lisa; We...},
