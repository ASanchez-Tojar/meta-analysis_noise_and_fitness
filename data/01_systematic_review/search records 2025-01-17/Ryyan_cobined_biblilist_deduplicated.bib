@ARTICLE{87,
key={rayyan-138683498},
title={The relative effects of forest amount, forest configuration, and urban matrix quality on forest breeding birds},
authors={Shoffner, Alexandra V.; Wilson, Andrew M.; Tang, Wenwu; Gagné, Sara A.},
journal={Scientific reports},
issn={},
volume={8},
issue={1},
pages={17140-17140},
