title={Airport noise disturbs foraging behavior of Japanese pipistrelle bats.},
authors={Wang, Weiwei; Gao, Huimin; Li, Chengrong; Deng, Yingchun; Zhou, Daying; Li, Yaqi; Zhou, Wenyu; Lu...},
