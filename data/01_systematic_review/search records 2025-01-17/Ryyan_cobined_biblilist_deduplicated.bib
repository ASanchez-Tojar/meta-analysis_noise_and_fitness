@ARTICLE{2176,
key={rayyan-138685996},
title={Lean birds in the city: body size and condition of house sparrows along the urbanization gradient},
authors={Liker, András; Papp, Zsuzsanna; Bókony, Veronika; Lendvai, Ádám Z.},
