@ARTICLE{2783,
key={rayyan-138687098},
title={Modelling correlated electron-ion diffusion in nano-scale TiO2: beyond periodic model and density functional theory},
authors={Peter Sushko},
journal={},
issn={},
volume={NA},
issue={NA},
pages={},
day={NA},
