@ARTICLE{255,
key={rayyan-138683678},
title={Associations between bird song attributes and noise, light, date, and temperature: Vermilion flycatchers (Pyrocephalus rubinus) sing shorter and higher pitched songs in territories with more artificial light at night},
authors={Ramírez, Sandra José; Chavez-Mendoza, Nayeli Evelin; Pérez, Jorge Vázquez; Ríos-Chelén, Alejandro...},
