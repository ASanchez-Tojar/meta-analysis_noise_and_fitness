title={Conservation physiology and the COVID-19 pandemic},
authors={Cooke, Steven J.; Cramp, Rebecca L.; Madliger, Christine L.; Bergman, Jordanna N.; Reeve, Connor;...},
journal={Conservation physiology},
issn={},
volume={9},
