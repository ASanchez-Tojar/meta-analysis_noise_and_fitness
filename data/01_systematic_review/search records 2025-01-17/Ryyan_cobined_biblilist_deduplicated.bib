title={Effect of replacing surface with underground rubbish containers on urban House Sparrows Passer domesticus},
authors={Bernat-Ponce, Edgar; Ferrer, David; Gil-Delgado, José A.; López-Iborra, Germán M.},
journal={Urban Ecosystems},
