title={Vocal Response to Traffic Noise in a Non-Passerine Bird: The Little Bustard Tetrax tetrax},
authors={Barrero, Adrián; Llusia, Diego; Traba, Juan; Iglesias-Merchan, Carlos; Morales, Manuel B.},
