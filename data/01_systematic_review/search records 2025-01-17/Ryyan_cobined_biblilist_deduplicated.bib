}

@ARTICLE{2781,
key={rayyan-138687093},
title={CONSERVATION OF SAGE-GROUSE AND SONGBIRDS: THE IMPACTS OF NOISE POLLUTION AND DIET QUALITY},
authors={PATRICELLI, G.},
journal={},
issn={},
volume={NA},
issue={NA},
pages={},
day={NA},
month={NA},
year={2015},
publisher={},
pmc_id={NA},
pubmed_id={NA},
url={},
abstract={Greater sage-grouse (CENTROCERCUS UROPHASIANUS) have been in the news a great deal lately, as the media covers the discussions among policy-makers, industry, conservationists, biologists, wildlife managers, and land owners about the fate of this species and its political and economic ramifications. Populations of greater sage-grouse are declining throughout their range (Connelly et al. 2004), leading to their designation as  warranted but precluded  for listing under the Endangered Species Act. In California, greater sage-grouse are listed as a Bird Species of Special Concern (year round), priority 2. Because sage-grouse are widely distributed across 11 western states on lands used heavily for ranching and energy development, listing under the Endangered Species Act would dramatically affect land use and costs could range into the hundreds of billions of dollars. This designation is scheduled for final decision in 2015. To improve sage-grouse population health and thus avoid the need to list these birds as endangered, it is critical to understand why populations are currently declining.My team is engaged in two projects related to conservation of sage-grouse throughout their range. The objective of the first project is to determine whether noise from human activities interferes with sage-grouse breeding activity. Previous work by my team has shown that noise negatively impacts sage-grouse abundance on breeding grounds, behavior and stress levels. The ongoing work on this project includes the development and use of a computer model to predict the acoustic footprint of development on the landscape. We will use this model to develop noise layers for statistical models of habitat use for sage-grouse, which can be used to determine the threshold of noise that impacts sage-grouse populations. The objective of the second project is to determine how diet and habitat use are related to fitness of sage-grouse. This involves radio-tracking to local foraging sites, then sampling sagebrush for analysis of nutritional value and toxin content. This will allow us to determine which sagebrush characteristics are preferred by sage-grouse, and how diet quality relates to breeding behaviors and success. Both of these projects will inform management of this species throughout their range, including California. We will continue to work with wildlife managers and policy makers to develop management strategies for sage-grouse and other sagebrush obligates. In addition to these two projects on sage-grouse behavior and conservation, my team is conducting a third project investigating whether California songbirds adjust their vocalizations and other behaviors in response to noise pollution. There has been a growing recognition in recent years that noise pollution may have profound and widespread impacts on wildlife, yet we still know remarkably little about the extent and magnitude of these impacts. One way that noise may affect animals is by disrupting communication, which plays a central role in animal social and reproductive life. We will compare the songs and singing behaviors of local songbirds (including red-winged blackbirds and tree swallows) between noisy and quiet areas in the Central Valley of California. We will also investigate how songbirds adjust their vocalizations and behaviors in response to the experimental introduction of noise. This information will help in predicting which species are likely to be affected by noise pollution, and in developing effective mitigation for these impacts.},
language={},
doi={},
}

