@ARTICLE{846,
key={rayyan-138684292},
title={Raptor research during the COVID-19 pandemic provides invaluable opportunities for conservation biology},
authors={Sumasgutner, Petra; Buij, Ralph; McClure, Christopher J. W.; Shaw, Phil; Dykstra, Cheryl R.; Kuma...},
journal={Biological conservation},
