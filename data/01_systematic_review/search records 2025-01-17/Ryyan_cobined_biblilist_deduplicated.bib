title={The effect of air pollution on immunological, antioxidative and hematological parameters, and body condition of Eurasian tree sparrows},
authors={Li, Mo; Nabi, Ghulam; Sun, Yanfeng; Wang, Yang; Wang, Limin; Jiang, Chuan; Cao, Pengxiu; Wu, Yuef...},
