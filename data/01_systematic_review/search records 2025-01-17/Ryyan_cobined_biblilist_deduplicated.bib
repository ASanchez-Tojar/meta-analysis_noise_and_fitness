title={Mitigating road impacts on animals through learning principles},
authors={Proppe, Darren S.; McMillan, Neil; Congdon, Jenna V.; Sturdy, Christopher B.},
journal={Animal cognition},
issn={},
volume={20},
issue={1},
pages={19-31},
