title={Cerebral consequences of environmental noise exposure.},
authors={Hahad, Omar; Bayo Jimenez, Maria Teresa; Kuntic, Marin; Frenis, Katie; Steven, Sebastian; Daiber,...},
journal={Environment international},
issn={},
