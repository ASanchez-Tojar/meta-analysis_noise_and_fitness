@ARTICLE{2597,
key={rayyan-138686620},
title={THE IMPACT OF PREDATOR-INDUCED STRESS ON THE SNOWSHOE HARE CYCLE},
authors={Boonstra, Rudy; Hik, David S.; Singleton, Grant R.; Tinnikov, Alexander},
journal={Ecological Monographs},
