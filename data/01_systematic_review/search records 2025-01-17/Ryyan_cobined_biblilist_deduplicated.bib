@ARTICLE{141,
key={rayyan-138683558},
title={Proximity to roads, but not exposure to metal pollution, is associated with accelerated developmental telomere shortening in nestling great tits.},
authors={Grunst, Andrea S.; Grunst, Melissa L.; Bervoets, Lieven; Pinxten, Rianne; Eens, Marcel},
journal={Environmental pollution (Barking, Essex : 1987)},
issn={},
volume={256},
issue={NA},
pages={113373-113373},
day={NA},
