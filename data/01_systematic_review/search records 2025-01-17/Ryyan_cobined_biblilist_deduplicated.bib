doi={10.11609/jott.8632.16.6.25360-25372},
}

@ARTICLE{997,
key={rayyan-138684451},
title={Swallows and Sparrows in the Human Street-Market Interface of Urban Nepal: Towards a First Open Access GIS Data and Model Inference on the Role of Religion and Culture in Bird Distribution},
authors={Hansen, Lindsay E.; Huettmann, Falk},
journal={Hindu Kush-Himalaya Watersheds Downhill: Landscape Ecology and Conservation Perspectives},
issn={},
