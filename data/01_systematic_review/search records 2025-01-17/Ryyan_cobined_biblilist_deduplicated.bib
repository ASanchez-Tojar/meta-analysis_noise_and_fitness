@ARTICLE{264,
key={rayyan-138687234},
title={The effect of urbanization and exposure to multiple environmental factors on life-history traits and breeding success of Barn Swallows (<i>Hirundo rustica</i>) across China},
authors={Zhao, Yanyan and Pagani-Nunez, Emilio and Liu, Yu and Xing, Xiaoying and Zhang, Zhiqiang and Pan, Guangji and Song, Luting and Li, Xiang and Zhou, Zhuoya and Chen, Yanqiu and Li, Donglai and Liu, Yang and Safran, Rebecca J.},
