@ARTICLE{2433,
key={rayyan-138686404},
title={Repeated stressors in adulthood increase the rate of biological ageing},
authors={Hau, Michaela; Haussmann, Mark F.; Greives, Timothy J.; Matlack, Christa; Costantini, David; Quet...},
journal={Frontiers in zoology},
issn={},
volume={12},
