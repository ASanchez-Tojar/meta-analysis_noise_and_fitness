title={Reproductive differences between urban and forest birds across the years: importance of environmental and weather parameters},
authors={Saulnier, Agnès; Bleu, Josefa; Boos, Anne; Millet, Maurice; Zahn, Sandrine; Ronot, Pascale; Masou...},
journal={Urban Ecosystems},
