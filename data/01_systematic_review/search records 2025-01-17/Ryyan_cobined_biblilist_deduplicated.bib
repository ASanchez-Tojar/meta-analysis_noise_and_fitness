title={Relationships between human disturbance and wildlife land use in urban habitat fragments.},
authors={Markovchick-Nicholls, Lisa; Regan, Helen M.; Deutschman, Douglas H.; Widyanata, Astrid; Martin, B...},
journal={Conservation biology : the journal of the Society for Conservation Biology},
issn={},
