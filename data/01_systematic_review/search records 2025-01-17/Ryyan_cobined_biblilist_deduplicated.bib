title={Early-Life Stress Drives the Molecular Mechanisms Shaping the Adult Phenotype},
authors={Huber, Susanne; Costantini, David; Houdelier, Cecilia; Marasco, Valeria},
journal={Fascinating Life Sciences},
issn={},
