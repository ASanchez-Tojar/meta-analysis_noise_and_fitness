@ARTICLE{1617,
key={rayyan-138685213},
title={An R2 statistic for fixed effects in the linear mixed model.},
authors={Edwards, Lloyd J.; Muller, Keith E.; Wolfinger, Russell D.; Qaqish, Bahjat F.; Schabenberger, Oliver},
journal={Statistics in medicine},
issn={},
volume={27},
issue={29},
pages={6137-6157},
day={NA},
