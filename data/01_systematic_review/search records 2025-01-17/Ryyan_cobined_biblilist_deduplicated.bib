@ARTICLE{906,
key={rayyan-138684357},
title={Anthropogenic noise may impair the mating behaviour of the Shore Crab Carcinus Maenas.},
authors={Rising, Kara; Hardege, Jörg; Tregenza, Tom; Stevens, Martin},
