@ARTICLE{802,
key={rayyan-138684247},
title={Exploring auditory thresholds for Reindeer, Rangifer tarandus},
authors={Perra, Megan; Brinkman, Todd; Scheifele, Peter; Barcalow, Sarah},
journal={Journal of Veterinary Behavior},
issn={},
volume={52},
issue={NA},
pages={37-44},
