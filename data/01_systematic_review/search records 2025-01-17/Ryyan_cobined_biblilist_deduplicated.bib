@ARTICLE{693,
key={rayyan-138684133},
title={Anthropogenic noise reduces avian feeding efficiency and increases vigilance along an urban‐rural gradient regardless of species' tolerances to urbanisation},
authors={Merrall, Eve S.; Evans, Karl L.},
journal={Journal of Avian Biology},
issn={},
