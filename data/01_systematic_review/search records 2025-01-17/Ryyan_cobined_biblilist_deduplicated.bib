title={Higher frequency of extra-pair offspring in urban than forest broods of great tits (Parus major)},
authors={Pipoly, Ivett; Szabó, Krisztián; Bókony, Veronika; Preiszner, Bálint; Seress, Gábor; Vincze, Ernő...},
