month={NA},
year={2021},
publisher={},
pmc_id={NA},
pubmed_id={NA},
url={},
abstract={Levels of anthropogenic noise and artificial light at night are rapidly rising on a global scale. Both sensory pollutants are well known to affect animal behaviour and physiology, which can lead to substantial ecological impacts. Most studies on noise or light pollution to date have focused on single stressor impacts, studying both pollutants in isolation despite their high spatial and temporal co-occurrence. However, few studies have addressed their combined impact, known as multisensory pollution, with the specific aim to assess whether the interaction between noise and light pollution leads to predictable, additive effects, or less predictable, synergistic or antagonistic effects. We carried out a systematic review of research investigating multisensory pollution and found 28 studies that simultaneously assessed the impact of anthropogenic noise and artificial light at night on animal function (e.g. behaviour, morphology or life-history), physiology (e.g. stress, oxidative or immune status) or population demography (e.g. abundance or species richness). Only fifteen of these studies specifically tested for possible interactive effects when both sensory pollutants were combined. Four out of eight experimental studies revealed a significant interaction effect, in contrast to only three out seven observational studies. We discuss the benefits and limitations of experimental versus observational studies addressing multisensory pollution and call for more specific testing of the diverse ways in which noise and light pollution can interact to affect wildlife.},
language={},
doi={10.3389/fevo.2021.765950},
}

@ARTICLE{189,
