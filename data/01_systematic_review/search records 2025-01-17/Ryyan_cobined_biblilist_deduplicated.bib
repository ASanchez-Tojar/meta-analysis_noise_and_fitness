title={Traffic noise affects colouration but not calls in the European treefrog (Hyla arborea)},
authors={Troïanowski, Mathieu; Condette, Camille; Mondy, Nathalie; Dumet, Adeline; Lengagne, Thierry},
journal={Behaviour},
issn={},
