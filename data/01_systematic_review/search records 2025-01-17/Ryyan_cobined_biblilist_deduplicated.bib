@ARTICLE{349,
key={rayyan-138683777},
title={Metabolic and respiratory costs of increasing song amplitude in zebra finches},
authors={Zollinger, Sue Anne; Goller, Franz; Brumm, Henrik},
journal={PloS one},
issn={},
volume={6},
issue={9},
pages={e23198-NA},
