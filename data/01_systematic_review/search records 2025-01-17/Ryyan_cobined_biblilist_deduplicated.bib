title={Universal assay for measuring vertebrate telomeres by real-time quantitative PCR},
authors={Hudon, Stephanie F.; Hurtado, Esteban Palencia; Beck, James D.; Burden, Steven; Bendixsen, Devin ...},
journal={NA},
