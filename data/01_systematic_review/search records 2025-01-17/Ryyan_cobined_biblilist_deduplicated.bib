@ARTICLE{56,
key={rayyan-138683463},
title={A New Framework for Urban Ecology: An Integration of Proximate and Ultimate Responses to Anthropogenic Change},
authors={Ouyang, Jenny Q.; Isaksson, Caroline; Schmidt, Chloé; Hutton, Pierce; Bonier, Frances; Dominoni, ...},
journal={Integrative and comparative biology},
