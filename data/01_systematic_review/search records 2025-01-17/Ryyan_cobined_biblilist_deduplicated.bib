@ARTICLE{607,
key={rayyan-138684043},
title={The song of Skylarks Alauda arvensis indicates the deterioration of an acoustic environment resulting from wind farm start‐up},
authors={Szymański, Paweł; Deoniziak, Krzysztof; Łosak, Katarzyna; Osiejuk, Tomasz S.},
journal={Ibis},
issn={},
volume={159},
issue={4},
pages={769-777},
