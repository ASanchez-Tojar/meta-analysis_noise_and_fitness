@ARTICLE{992,
key={rayyan-138684445},
title={Urban environment shortens telomere length in nestling great tits, Parus major},
authors={Salmón, Pablo; Nilsson, Johan; Nord, Andreas; Bensch, Staffan; Isaksson, Caroline},
journal={Biology letters},
issn={},
volume={12},
issue={6},
pages={20160155-NA},
