@ARTICLE{826,
key={rayyan-138684272},
title={Proceedings of the National Academy of Sciences of the United States of America - Low-frequency songs lose their potency in noisy urban conditions},
authors={Halfwerk, Wouter; Bot, Sander; Buikx, Jasper; van der Velde, Marco; Komdeur, Jan; Cate, Carel ten...},
