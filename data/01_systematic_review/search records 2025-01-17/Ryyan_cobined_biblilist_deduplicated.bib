@ARTICLE{2513,
key={rayyan-138686510},
title={Ski tourism affects habitat use and evokes a physiological stress response in capercaillie Tetrao urogallus: a new methodological approach},
authors={Thiel, Dominik; Jenni-Eiermann, Susanne; Braunisch, Veronika; Palme, Rupert; Jenni, Lukas},
