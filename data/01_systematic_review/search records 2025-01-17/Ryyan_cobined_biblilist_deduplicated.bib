@ARTICLE{843,
key={rayyan-138684289},
title={Building Development and Roads: Implications for the Distribution of Stone Curlews across the Brecks},
authors={Clarke, Ralph T.; Liley, D.; Sharp, Joanna M.; Green, Rhys E.},
journal={PloS one},
issn={},
volume={8},
