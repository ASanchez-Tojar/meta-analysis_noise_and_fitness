doi={10.1038/srep20540},
}

@ARTICLE{109,
key={rayyan-138683521},
title={A multidimensional framework to quantify the effects of urbanization on avian breeding fitness.},
authors={Chen, Sihao; Liu, Yu; Patrick, Samantha C; Goodale, Eben; Safran, Rebecca J; Pagani-Núñez, Emilio},
