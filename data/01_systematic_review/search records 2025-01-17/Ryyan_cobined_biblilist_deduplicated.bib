@ARTICLE{613,
key={rayyan-138684049},
title={Does learning matter? Birdsong-learning program determines coping strategies for living in urban noisy environments},
authors={Rivera-Gutierrez, Hector F.; Jaramillo-Calle, Vannesa; Lopera-Salazar, Andrea; Martinez-Alvarado,...},
journal={Behavioral Ecology and Sociobiology},
issn={},
volume={77},
issue={2},
pages={NA-NA},
