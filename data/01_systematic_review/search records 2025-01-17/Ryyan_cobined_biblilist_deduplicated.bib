title={The impacts of maternal stress on worker phenotypes in the honey bee},
authors={Preston, Sarah R.; Palmer, Joseph H.; Harrison, James W.; Carr, Hanna M.; Rittschof, Clare C.},
journal={Apidologie},
issn={},
