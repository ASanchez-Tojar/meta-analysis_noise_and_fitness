title={Variation in diurnal patterns of singing activity between urban and rural great tits},
authors={Bermúdez-Cuamatzin, Eira; Delamore, Zoë; Verbeek, Laura; Kremer, Christoph; Slabbekoorn, Hans},
journal={Frontiers in Ecology and Evolution},
