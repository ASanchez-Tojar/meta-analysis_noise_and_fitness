@ARTICLE{798,
key={rayyan-138684243},
title={Urban cycles of human activity do not significantly alter the behaviour of a duetting bird},
authors={Diniz, Pedro; Silva-Jr, Edvaldo F.; Macedo, Regina H.},
journal={Ibis},
issn={},
volume={163},
issue={4},
pages={1394-1408},
