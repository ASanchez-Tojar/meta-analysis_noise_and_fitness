title={Extrapair paternity alongside social reproduction increases male lifetime fitness},
authors={Dunning, Jamie; Sánchez-Tójar, Alfredo; Girndt, Antje; Burke, Terry; Hsu, Yu-Hsun; Nakagawa, Shin...},
journal={Animal Behaviour},
issn={},
volume={213},
issue={NA},
pages={117-123},
