@ARTICLE{1119,
key={rayyan-138684597},
title={Differential post-fledging survival of great and coal tits in relation to their condition and fledging date},
authors={Naef-Daenzer, Beat; Widmer, Fritz; Nuber, Maria},
journal={Journal of Animal Ecology},
issn={},
volume={70},
issue={5},
pages={730-738},
