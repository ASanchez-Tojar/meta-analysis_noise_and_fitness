title={The influence of sex and body size on nestling survival and recruitment in the house sparrow},
authors={Cleasby, Ian R.; Nakagawa, Shinichi; Gillespie, Duncan; Burke, Terry},
journal={Biological Journal of the Linnean Society},
issn={},
