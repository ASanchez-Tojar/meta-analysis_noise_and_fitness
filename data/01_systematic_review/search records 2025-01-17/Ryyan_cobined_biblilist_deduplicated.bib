@ARTICLE{435,
key={rayyan-138683865},
title={Seasonal productivity in a population of migratory songbirds: why nest data are not enough},
authors={Streby, Henry M.; Andersen, David E.},
journal={Ecosphere},
issn={},
volume={2},
issue={7},
pages={1-15},
