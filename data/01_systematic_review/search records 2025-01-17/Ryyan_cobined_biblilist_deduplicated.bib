title={Density-dependent recruitment rates in great tits: the importance of being heavier},
authors={Both, Christiaan; Visser, Marcel E.; Verboven, Nanette},
journal={Proceedings of the Royal Society of London. Series B: Biological Sciences},
issn={},
volume={266},
