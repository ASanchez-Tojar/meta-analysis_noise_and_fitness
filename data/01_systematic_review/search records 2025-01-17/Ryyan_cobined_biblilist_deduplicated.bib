@ARTICLE{733,
key={rayyan-138684174},
title={Avian Sound Perception in Noise},
authors={Dooling, Robert J.; Blumenrath, Sandra H.},
journal={Animal Signals and Communication},
issn={},
volume={NA},
issue={NA},
pages={229-250},
