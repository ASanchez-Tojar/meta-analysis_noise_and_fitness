@ARTICLE{1896,
key={rayyan-138685609},
title={The ecological impacts of nighttime light pollution: a mechanistic appraisal},
authors={Gaston, Kevin J.; Bennie, Jonathan; Davies, Thomas W.},
journal={Biological reviews of the Cambridge Philosophical Society},
issn={},
volume={88},
issue={4},
pages={912-927},
day={NA},
