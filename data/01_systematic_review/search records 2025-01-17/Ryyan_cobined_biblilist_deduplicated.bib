title={ETHOLOGY - Variation in reproductive success across captive populations: Methodological differences, potential biases and opportunities},
authors={Griffith, Simon C.; Crino, Ondi L.; Andrew, Samuel C.; Nomano, Fumiaki Y.; Adkins-Regan, Elizabet...},
