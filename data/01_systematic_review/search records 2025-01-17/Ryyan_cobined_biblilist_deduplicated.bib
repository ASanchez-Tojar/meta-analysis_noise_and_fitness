@ARTICLE{131,
key={rayyan-138683547},
title={Nestling European Starlings (<i>Sturnus vulgaris</i>) adjust their begging calls in noise},
authors={Dharmasiri, Maheshi E.; Barber, Colleen A.; Horn, Andrew G.},
journal={Bioacoustics},
issn={},
