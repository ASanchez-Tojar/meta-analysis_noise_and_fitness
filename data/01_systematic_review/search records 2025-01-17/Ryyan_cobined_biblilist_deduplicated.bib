title={Effect of traffic noise on Scinax nasicus advertisement call (Amphibia, Anura)},
authors={Leon, Evelina Jesica; Peltzer, Paola; Lorenzón, Rodrigo Ezequiel; Lajmanovich, Rafael Carlos; Bel...},
journal={Iheringia. Série Zoologia},
