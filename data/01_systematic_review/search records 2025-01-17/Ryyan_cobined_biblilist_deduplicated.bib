@ARTICLE{77,
key={rayyan-138683487},
title={Different sound exposures causes alterations in stress-related serum indicators, behaviors, and cecal microbiota of green-shell egg-laying chickens under different stocking densities.},
authors={Cao, Shiwen; Ye, Manhong; Wei, Wanhong; Yang, Fengping},
