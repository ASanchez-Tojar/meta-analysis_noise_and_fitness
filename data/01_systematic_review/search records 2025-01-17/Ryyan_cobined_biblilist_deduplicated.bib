title={Night lighting and anthropogenic noise alter the activity and body condition of pinyon mice (Peromyscus truei)},
authors={Willems, Joshua S.; Phillips, Jennifer N.; Vosbigian, Ryan A.; Villablanca, Francis X.; Francis, ...},
journal={Ecosphere},
