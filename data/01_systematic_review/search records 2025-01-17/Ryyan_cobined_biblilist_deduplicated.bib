@ARTICLE{1664,
key={rayyan-138685275},
title={Do females invest more into eggs when males sing more attractively? Postmating sexual selection strategies in a monogamous reed passerine},
authors={Krištofík, Ján; Darolová, Alžbeta; Majtan, Juraj; Okuliarova, Monika; Zeman, Michal; Hoi, Herbert},
journal={Ecology and evolution},
