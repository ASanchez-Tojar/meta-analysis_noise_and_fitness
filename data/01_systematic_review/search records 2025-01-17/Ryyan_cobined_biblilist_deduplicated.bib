title={Conspecific cues and breeding habitat selection in an endangered woodland warbler.},
authors={Farrell, Shannon L.; Morrison, Michael L.; Campomizzi, Andrew J.; Wilkins, R. Neal},
journal={The Journal of animal ecology},
issn={},
