title={Crowding in the city: losing and winning competitors of an invasive bird.},
authors={Hernández-Brito, Dailos; Carrete, Martina; Popa-Lisseanu, Ana G.; Ibáñez, Carlos F.; Tella, José ...},
journal={PloS one},
