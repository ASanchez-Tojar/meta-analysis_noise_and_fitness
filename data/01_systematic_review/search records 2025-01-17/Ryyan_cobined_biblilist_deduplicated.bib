@ARTICLE{2786,
key={rayyan-138687105},
title={Table_3_Territory Quality Predicts Avian Vocal Performance Across an Urban-Rural Gradient.XLSX},
authors={Phillips, Jennifer N and Cooper, Justin W and Luther, David A and Derryberry, Elizabeth P},
journal={Figshare},
issn={},
volume={NA},
issue={NA},
