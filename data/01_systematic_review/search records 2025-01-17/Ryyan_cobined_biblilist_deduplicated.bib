@ARTICLE{2746,
key={rayyan-138686994},
title={International  Research Fellowship Program:  Effects of Ambient Noise on Song-learning and Mate Choice in Zebra Finches},
authors={Kight,  Caitlin},
journal={},
issn={},
volume={NA},
issue={NA},
