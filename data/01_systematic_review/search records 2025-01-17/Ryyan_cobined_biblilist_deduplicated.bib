title={Road induced edge effects on a forest bird community in tropical Asia},
authors={Khamcha, Daphawan; Corlett, Richard T.; Powell, Larkin A.; Savini, Tommaso; Lynam, Antony J.; Gal...},
journal={Avian Research},
