@ARTICLE{729,
key={rayyan-138684170},
title={An Urban Acoustic Rainfall Estimation Technique Using a CNN Inversion Approach for Potential Smart City Applications},
authors={Alkhatib, Mohammed I. I.; Talei, Amin; Chang, Tak Kwin; Pauwels, Valentijn R. N.; Chow, Ming Fai},
journal={Smart Cities},
issn={},
volume={6},
