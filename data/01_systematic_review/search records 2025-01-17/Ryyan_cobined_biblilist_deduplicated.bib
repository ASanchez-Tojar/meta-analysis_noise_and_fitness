@ARTICLE{2019,
key={rayyan-138685775},
title={Stress response during development predicts fitness in a wild, long lived vertebrate},
authors={Blas, Julio; Bortolotti, Gary R.; Tella, José Luis; Baos, Raquel; Marchant, Tracy A.},
journal={Proceedings of the National Academy of Sciences of the United States of America},
issn={},
