title={Accelerated Aging and Age-Related Diseases (CVD and Neurological) Due to Air Pollution and Traffic Noise Exposure.},
authors={Hahad, Omar; Frenis, Katie; Kuntic, Marin; Daiber, Andreas; Münzel, Thomas},
