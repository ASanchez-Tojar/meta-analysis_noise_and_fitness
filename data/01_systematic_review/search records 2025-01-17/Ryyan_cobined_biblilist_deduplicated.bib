@ARTICLE{947,
key={rayyan-138684399},
title={Human recreation decreases antibody titres in bird nestlings: an overlooked transgenerational effect of disturbance},
authors={Bötsch, Yves; Tablado, Zulima; Almasi, Bettina; Jenni, Lukas},
journal={The Journal of experimental biology},
issn={},
volume={223},
issue={8},
pages={NA-NA},
