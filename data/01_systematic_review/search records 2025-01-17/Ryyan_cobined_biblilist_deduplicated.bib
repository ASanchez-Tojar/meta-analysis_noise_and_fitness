@ARTICLE{2179,
key={rayyan-138686002},
title={Species-Dependent Effects of the Urban Environment on Fatty Acid Composition and Oxidative Stress in Birds},
authors={Isaksson, Caroline; Andersson, Martin; Nord, Andreas; von Post, Maria; Wang, Hong-Lei},
