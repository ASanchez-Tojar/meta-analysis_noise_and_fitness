@ARTICLE{319,
key={rayyan-138683745},
title={Territory Quality Predicts Avian Vocal Performance Across an Urban-Rural Gradient},
authors={Phillips, Jennifer N.; Cooper, W. Justin; Luther, David; Derryberry, Elizabeth P.},
journal={Frontiers in Ecology and Evolution},
issn={},
volume={8},
issue={NA},
pages={NA-NA},
