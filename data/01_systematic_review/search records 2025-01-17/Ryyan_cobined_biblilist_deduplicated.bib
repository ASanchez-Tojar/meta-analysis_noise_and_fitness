@ARTICLE{324,
key={rayyan-138683750},
title={Behavioral responses to anthropogenic noise at highways vary across temporal scales},
authors={Collins, Amy C.; Vickers, T. Winston; Shilling, Fraser M.},
journal={Frontiers in Ecology and Evolution},
issn={},
volume={10},
issue={NA},
pages={NA-NA},
