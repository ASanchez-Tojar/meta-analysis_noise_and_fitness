title={Oil and gas development does not reduce duck pair abundance in the Prairie Pothole Region},
authors={Loesch, Charles R.; Kemink, Kaylan M.; Cressey-Smith, Ryann; Gue, C. Tanner; Sieges, Mason L.; Sz...},
