@ARTICLE{245,
key={rayyan-138683668},
title={Baseline and stress-induced corticosterone levels across birds and reptiles do not reflect urbanization levels.},
authors={Injaian, Allison; Francis, Clinton D.; Ouyang, Jenny Q.; Dominoni, Davide M.; Donald, Jeremy W; F...},
journal={Conservation physiology},
