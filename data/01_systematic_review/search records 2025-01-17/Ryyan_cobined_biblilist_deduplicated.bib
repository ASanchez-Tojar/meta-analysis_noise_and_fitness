@ARTICLE{619,
key={rayyan-138684055},
title={Nestling growth rate and food consumption increases under experimentally prolonged daylength in a New World sparrow},
authors={Byrd, Allison J.; Mullins, Colleen S.; Becker, Daniel J.; Fudickar, Adam M.},
journal={Journal of Avian Biology},
issn={},
volume={2023},
issue={11},
pages={NA-NA},
