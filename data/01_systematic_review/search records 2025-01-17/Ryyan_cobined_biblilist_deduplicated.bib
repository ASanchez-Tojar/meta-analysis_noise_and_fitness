title={Learning to cope: vocal adjustment to urban noise is correlated with prior experience in black-capped chickadees},
authors={LaZerte, Stefanie E.; Slabbekoorn, Hans; Otter, Ken A.},
journal={Proceedings. Biological sciences},
issn={},
volume={283},
issue={1833},
pages={20161058-NA},
