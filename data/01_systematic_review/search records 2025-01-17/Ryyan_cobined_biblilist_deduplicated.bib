@ARTICLE{341,
key={rayyan-138683769},
title={Avian fitness consequences match habitat selection at the nest‐site and landscape scale in agriculturally fragmented landscapes},
authors={Reiley, Bryan M.; Benson, Thomas J.},
journal={Ecology and evolution},
issn={},
volume={9},
issue={12},
pages={7173-7183},
day={NA},
