title={Natural and anthropogenic noise increase vigilance and decrease foraging behaviors in song sparrows},
authors={Sweet, K A; Sweet, B P; Gomes, D G E; Francis, C D; Barber, J R},
journal={Behavioral Ecology},
issn={},
