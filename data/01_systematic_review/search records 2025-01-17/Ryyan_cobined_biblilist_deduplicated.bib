@ARTICLE{609,
key={rayyan-138684045},
title={Effect of anthropogenic city noise on the vocalizations of four disparate forest birds},
authors={Bahía, Rocío; Lambertucci, Sergio A.; Speziale, Karina L.},
journal={NA},
issn={},
volume={NA},
issue={NA},
pages={NA-NA},
