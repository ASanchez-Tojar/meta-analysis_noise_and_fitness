title={Corticosterone predicts foraging behavior and parental care in macaroni penguins.},
authors={Crossin, Glenn T.; Trathan, Phil N.; Phillips, Richard A.; Gorman, Kristen B.; Dawson, Alistair; ...},
journal={The American naturalist},
issn={},
