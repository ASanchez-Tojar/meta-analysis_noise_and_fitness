title={Natural Sounds Alter California Ground Squirrel, Otospermophilus beecheyi , Foraging, Vigilance and Movement Behaviours},
authors={Le, My-Lan T.; Garvin, Christopher M.; Barber, Jesse R.; Francis, Clinton D.},
