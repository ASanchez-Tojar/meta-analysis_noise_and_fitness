@ARTICLE{571,
key={rayyan-138684007},
title={Evaluating the ability of occurrence models to predict nest locations and associated vegetation},
authors={Fogarty, Frank A.; Fleishman, Erica; Zillig, Martha Wohlfeil},
journal={Ibis},
