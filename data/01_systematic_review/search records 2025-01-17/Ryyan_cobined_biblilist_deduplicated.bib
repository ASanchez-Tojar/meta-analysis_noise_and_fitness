@ARTICLE{1361,
key={rayyan-138684893},
title={Stress-responsiveness influences baseline glucocorticoid levels: Revisiting the under 3 min sampling rule},
authors={Small, Thomas W.; Bebus, Sara E.; Bridge, Eli S.; Elderbrock, Emily K.; Ferguson, Stephen M.; Jon...},
journal={General and comparative endocrinology},
