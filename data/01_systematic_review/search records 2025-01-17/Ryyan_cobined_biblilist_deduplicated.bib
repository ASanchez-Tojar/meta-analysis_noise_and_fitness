@ARTICLE{180,
key={rayyan-138683599},
title={Insights on the effect of aircraft traffic on avian vocal activity},
authors={Vincelette, Hannah; Buxton, Rachel T.; Kleist, Nathan J.; McKenna, Megan F.; Betchkal, Davyd; Wit...},
journal={Ibis},
