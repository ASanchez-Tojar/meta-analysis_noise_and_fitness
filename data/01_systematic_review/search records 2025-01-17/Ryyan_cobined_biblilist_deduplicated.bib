@ARTICLE{917,
key={rayyan-138684368},
title={Repeated exposure reduces the response to impulsive noise in European seabass.},
authors={Radford, Andrew N.; Lèbre, Laurie; Lecaillon, Gilles; Nedelec, Sophie L.; Simpson, Stephen D.},
journal={Global change biology},
