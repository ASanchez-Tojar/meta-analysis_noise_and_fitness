@ARTICLE{338,
key={rayyan-138683766},
title={Forest bat activity declines with increasing wind speed in proximity of operating wind turbines},
authors={Ellerbrok, Julia S.; Farwig, Nina; Peter, Franziska; Voigt, Christian C.},
journal={Global Ecology and Conservation},
issn={},
volume={49},
issue={NA},
pages={e02782-e02782},
