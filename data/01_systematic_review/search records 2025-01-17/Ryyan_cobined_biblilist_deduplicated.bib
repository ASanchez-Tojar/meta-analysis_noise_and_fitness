title={Boat noise affects meagre (Argyrosomus regius) hearing and vocal behaviour.},
authors={Vieira, Manuel; Beauchaud, Marilyn; Amorim, M. Clara P.; Fonseca, Paulo J.},
journal={Marine pollution bulletin},
