title={Does railway noise affect forest birds during the winter},
authors={Wiącek, Jarosław; Polak, Marcin; Filipiuk, Maciej; Kucharczyk, Marek},
journal={European Journal of Forest Research},
issn={},
volume={138},
issue={5},
pages={907-915},
