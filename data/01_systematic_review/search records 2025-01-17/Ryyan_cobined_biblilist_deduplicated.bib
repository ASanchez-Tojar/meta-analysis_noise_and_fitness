title={Data from: Why does noise reduce response to alarm calls? Experimental assessment of masking, distraction and greater vigilance in wild birds},
authors={Zhou, You and Radford, Andrew N and Magrath, Robert D},
journal={Dryad},
issn={},
volume={NA},
