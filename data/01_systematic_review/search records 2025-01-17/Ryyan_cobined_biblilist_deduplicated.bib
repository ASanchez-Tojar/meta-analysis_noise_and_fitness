title={Singing under glass: Rapid effects of anthropogenic habitat modification on song and response behaviours in an isolated house sparrow (Passer domesticus) population},
authors={Sheldon, Elizabeth L.; Ironside, Joseph E.; de Vere, Natasha; Marshall, Rupert C.},
journal={Journal of Avian Biology},
issn={},
