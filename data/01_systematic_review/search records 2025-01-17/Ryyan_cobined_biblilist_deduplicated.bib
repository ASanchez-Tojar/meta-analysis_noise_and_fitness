title={Antibacterial immune functions of subadults and adults in a semelparous spider.},
authors={Rádai, Zoltán; Kiss, Péter János; Nagy, Dávid; Barta, Zoltán},
journal={PeerJ},
issn={},
volume={7},
issue={NA},
pages={e7475-NA},
