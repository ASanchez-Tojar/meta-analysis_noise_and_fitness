title={Urban birdsongs: higher minimum song frequency of an urban colonist persists in a common garden experiment},
authors={Reichard, Dustin G.; Atwell, Jonathan W.; Pandit, Meelyn M; Cardoso, Gonçalo C.; Price, Trevor D....},
