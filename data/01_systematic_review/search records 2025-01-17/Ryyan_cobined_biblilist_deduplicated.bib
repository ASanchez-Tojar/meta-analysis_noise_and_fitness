title={A sonic net excludes birds from an airfield: implications for reducing bird strike and crop losses.},
authors={Swaddle, John P.; Moseley, Dana L.; Hinders, Mark K.; Smith, Elizabeth P.},
journal={Ecological applications : a publication of the Ecological Society of America},
issn={},
