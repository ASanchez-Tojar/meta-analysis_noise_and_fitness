@ARTICLE{933,
key={rayyan-138684384},
title={Selective disappearance of great tits with short telomeres in urban areas.},
authors={Salmón, Pablo; Nilsson, Johan; Watson, Hannah; Bensch, Staffan; Isaksson, Caroline},
