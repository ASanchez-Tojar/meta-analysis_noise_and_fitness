key={rayyan-138687063},
title={Image_1_Differential effects of anthropogenic noise and vegetation cover on the breeding phenology and success of two urban passerines.pdf},
authors={Monniez, Emmanuelle and Jiguet, Frederic and Vignal, Clementine and Biard, Clotilde},
journal={Figshare},
issn={},
volume={NA},
