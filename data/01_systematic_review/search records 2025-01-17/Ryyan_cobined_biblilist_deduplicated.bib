@ARTICLE{2262,
key={rayyan-138687201},
title={The impact of anthropogenic noise on birds' communication and fitness.},
authors={Viigipuu, Riin and Tilgar, Vallo},
journal={Hirundo},
issn={1406-2062},
volume={30},
issue={1},
pages={36-56},
day={NA},
