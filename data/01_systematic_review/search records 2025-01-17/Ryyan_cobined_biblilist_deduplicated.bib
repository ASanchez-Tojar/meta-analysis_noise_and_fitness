title={Birds living near airports do not show consistently higher levels of feather corticosterone.},
authors={Alquezar, Renata D; Arregui, Lucía; Macedo, Regina H; Gil, Diego},
journal={Conservation physiology},
issn={},
volume={11},
issue={1},
pages={coad079-NA},
day={NA},
