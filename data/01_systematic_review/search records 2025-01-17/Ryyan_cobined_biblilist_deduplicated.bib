title={Effects of the COVID-19 Lockdown on Urban Light Emissions: Ground and Satellite Comparison},
authors={Bustamante-Calabria, Máximo; de Miguel, Alejandro Sánchez; Martín-Ruiz, Susana; Ortiz, Jose Luis;...},
