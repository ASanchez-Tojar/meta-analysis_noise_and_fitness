title={Sensitive aerial hearing within a noisy nesting soundscape in a deep-diving seabird, the common murre Uria aalge},
authors={Smith, AB; Fischer-McMorrow, I; Kolbeinsson, Y; Rasmussen, M; Shero, MR; McElwaine, JN; Jones, OR...},
