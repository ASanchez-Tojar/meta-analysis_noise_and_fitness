@ARTICLE{283,
key={rayyan-138683706},
title={Differences among domestic chicken breeds in tonic immobility responses as a measure of fearfulness.},
authors={Tiemann, Inga; Becker, Senta; Fournier, Jocelyn; Damiran, Daalkhaijav; Büscher, Wolfgang; Hillema...},
