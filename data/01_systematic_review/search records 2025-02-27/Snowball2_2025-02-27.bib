title={Effects of music stimulus on behavior response, cortisol level, and horizontal immunity of growing pigs},
author={Li and Jiafang; Li and Xiang; Liu and Honggui; Li and Jianhong; Han and Qian; Wang and Chao; Zeng and Xiangyin; Li and Yutao; Ji and Wenbo; Zhang and Runxiang; Bao and Jun},
