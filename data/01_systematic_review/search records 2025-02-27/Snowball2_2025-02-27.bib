@ARTICLE{662,
title={Global quieting of high-frequency seismic noise due to COVID-19 pandemic lockdown measures},
author={Lecocq and Thomas; Hicks and Stephen; Van Noten and Koen; van Wijk and Kasper; Koelemeijer and Paula; De Plaen and Raphael S. M.; Massin and Frédérick; Hillers and Gregor; Anthony and Robert E.; Apoloner and Maria-Theresia; Arroyo-Solórzano and Mario; Assink and Jelle; Büyükakpınar, Pınar; Cannata and Andrea; Cannavò and Flavio; Carrasco and Sebastián; Caudron and Corentin; Chaves and Esteban J.; Cornwell and Dave; Craig and David; Ouden and Olivier F. C. den; Diaz and Jordi; Donner and Stefanie; Evangelidis and Christos; Evers, Läslo; Fauville and Benoit; Fernandez and Gonzalo A.; Giannopoulos and Dimitrios; Gibbons and Steven J.; Girona, Társilo; Grecu and Bogdan; Grunberg and Marc; Hetényi and György; Horleston and Anna; Inza and Adolfo; Irving and Jessica C. E.; Jamalreyhani and Mohammadreza; Kafka and Alan L.; Koymans and Mathijs; Labedz, C. R.; Larose and Eric; Lindsey and Nathaniel J.; McKinnon and Mika; Megies, T.; Miller and Meghan S.; Minarik and William G.; Moresi and Louis; Márquez-Ramírez and Victor H.; Möllhoff and Martin; Nesbitt and Ian M.; Niyogi and Shankho; Ojeda and Javier; Oth and Adrien; Proud and Simon Richard; Pulli and Jay J.; Retailleau and Lise; Rintamäki and Annukka E.; Satriano and Claudio; Savage and Martha K.; Shani-Kadmiel and Shahar; Sleeman and Reinoud; Sokos and Efthimios; Stammler and Klaus; Stott and Alexander E.; Subedi and Shiba; Sørensen and Mathilde B.; Taira and Taka'aki; Tapia and Mar; Turhan and Fatih; van der Pluijm and Ben A.; Vanstone and Mark; Vergne, Jérôme; Vuorinen and Tommi; Warren and Tristram; Wassermann and Joachim; Xiao and Han},
journal={NA},
issn={NA},
volume={369},
year={2020},
publisher={American Association for the Advancement of Science (AAAS)},
abstract={Human activity causes vibrations that propagate into the ground as high-frequency seismic waves. Measures to mitigate the coronavirus disease 2019 (COVID-19) pandemic caused widespread changes in human activity, leading to a months-long reduction in seismic noise of up to 50%. The 2020 seismic noise quiet period is the longest and most prominent global anthropogenic seismic noise reduction on record. Although the reduction is strongest at surface seismometers in populated areas, this seismic quiescence extends for many kilometers radially and hundreds of meters in depth. This quiet period provides an opportunity to detect subtle signals from subsurface seismic sources that would have been concealed in noisier times and to benchmark sources of anthropogenic noise. A strong correlation between seismic noise and independent measurements of human mobility suggests that seismology provides an absolute, real-time estimate of human activities.},
language={NA},
doi={10.1126/science.abd2438},
}

