@ARTICLE{543,
title={Chronic exposure of rats to occupational textile noise causes cytological changes in adrenal cortex},
author={Oliveira and Maria João; Monteiro and Mariana P.; Ribeiro and Andreia M.; Pignatelli and Duarte; Águas and Artur P.},
journal={NA},
