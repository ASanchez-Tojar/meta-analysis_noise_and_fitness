@ARTICLE{1903,
title={Cognition as a neglected mediator of responses to anthropogenic noise},
author={Grunst and Andrea S; Grunst and Melissa L},
journal={NA},
issn={NA},
volume={30},
year={2023},
publisher={NA},
abstract={Anthropogenic noise is an increasingly pervasive global disturbance factor, with diverse biological effects. Yet, most studies have focused on population mean responses to noise pollution, leaving sources of among-individual differences in responses poorly understood. Blackburn et al. (2023) provide the first evidence from free-living animals that cognition might mediate individual differences in responses to noise pollution. In this commentary, we highlight the contribution of this ground-breaking study to stimulate more research on this important topic. We argue that cognition might mediate among-individual differences in the ability to cope with both masking effects and stress associated with noise pollution.},
language={NA},
doi={10.1111/gcb.17083},
