@ARTICLE{527,
title={EFFECTS OF SOUND ON ENDOCRINE FUNCTION AND ELECTROLYTE EXCRETION},
author={Lockett and Mary F.},
journal={NA},
issn={NA},
volume={NA},
year={1970},
publisher={Springer US},
abstract={Loud sounds, intense light, immobilization, anxiety, forced exercise, surgery, cold and many other stressful agents increase the secretion of corticotrophin (ACTH) from the adenohypophysis. In each case, the mechanism by which the secretion of ACTH is accelerated is neurohumoral (1) and is mediated through the central nervous system (2). The resulting elevation in plasma concentrations of ACTH causes an increase in the secretion of adrenal corticoids; the additional corticoid secreted is that characteristic of the particular species under stress (4). Thus, loud sounds raise plasma concentrations of corticosterone in the rat (5) and of 17-hydroxycorticosterone in man (6) and in monkeys (7). High concentrations of ACTH also increase the rate of secretion of aldosterone (8).},
language={NA},
