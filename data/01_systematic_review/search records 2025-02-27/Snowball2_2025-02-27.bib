@ARTICLE{110,
title={URBAN NOISE PREDICTS SONG FREQUENCY IN NORTHERN CARDINALS AND AMERICAN ROBINS},
author={Seger-Fullam and Kerri D.; Rodewald and Amanda D.; Soha and Jill A.},
journal={NA},
