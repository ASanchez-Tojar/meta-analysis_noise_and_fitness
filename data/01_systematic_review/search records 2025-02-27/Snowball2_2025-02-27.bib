title={Dynamics of a Predator–Prey System with Impulsive Stocking Prey and Nonlinear Harvesting Predator at Different Moments},
author={Zhou and Zeli; Jiao and Jianjun; Dai and Xiangjun; Wu and Lin},
journal={NA},
