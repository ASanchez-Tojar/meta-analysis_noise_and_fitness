@ARTICLE{1624,
title={Oviposition preference and development of Maruca vitrata (Fabricius) (Lepidoptera: Crambidae) on different radiofrequency fields},
author={Maharjan and Rameswor; Bae and Soon-Do; Kim and Gil-Hah; Yoon and Young-Nam; Jang and Yunwoo; Kim and Yong-Chul; Yi and Hwijong},
journal={NA},
